{
  "name": "metrika-room",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "yarn typecheck && vite build",
    "lint": "node --experimental-strip-types scripts/lint.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc && tsc -p tsconfig.sw.json",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "9.22.0",
    "@rolldown/plugin-babel": "^0.3.2",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/babel__core": "^7.20.5",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/webxr": "^0.5.24",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "9.22.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0"
  }
}
